# Copy the value into Railway Variables. Use comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional backend-only secret. Leave blank to disable web imports.
STANDARDS_IMPORT_TOKEN=

# Arize AX tracing. Set both credentials to enable it.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=archgovasst
# ARIZE_COLLECTOR_ENDPOINT=

# Chroma on Railway. Set these in the FastAPI service's Variables tab.
# Replace Chroma with the actual Railway service name. The port defaults to 8000.
# CHROMA_PRIVATE_HOST=${{Chroma.RAILWAY_PRIVATE_DOMAIN}}
# CHROMA_PORT=8000

# For a custom or local Chroma endpoint, use CHROMA_URL alone instead.
# CHROMA_URL=http://localhost:8000

# Optional overrides for a self-hosted Chroma server.
CHROMA_TENANT=
CHROMA_DATABASE=

# Chroma Cloud only. Set this along with tenant and database instead of a server address.
# CHROMA_API_KEY=

# Reviews use the OpenAI API directly. Set the key only on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CHROMA_STANDARDS_COLLECTION=governance-standards
# Set an absolute path on a writable persistent volume for hosted deployments.
GOVERNANCE_CHECKPOINT_DB=governance-reviews.sqlite3
